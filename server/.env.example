# Copy to .env and fill in. Never commit the real file.
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/mindcheck for a local server)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/mindcheck?retryWrites=true&w=majority

# Long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the web app runs. Comma-separate several origins.
CLIENT_URL=http://localhost:5173

# AI companion (optional). Leave ENABLE_CHATBOT=false to run without it.
ENABLE_CHATBOT=false
OPENAI_API_KEY=your-api-key
# Any OpenAI-compatible endpoint and model; the defaults use OpenRouter.
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-3.5-turbo
# Companion messages per user per hour
CHAT_LIMIT_PER_HOUR=40

# Only for the API tests: a throwaway database that the tests may wipe.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/mindcheck_test
